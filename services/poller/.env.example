# Copy to .env and fill in
DATABASE_URL=postgresql://user:password@localhost:5432/train_monitor_v2
# Refresh live (circulating) trains every N seconds. POLL_INTERVAL_SECONDS
# is kept as a deprecated alias for the same setting.
ACTIVE_INTERVAL_SECONDS=40
# Sweep station boards for NEW trains every N seconds (known runs are
# skipped, so sweeps write almost nothing).
DISCOVERY_INTERVAL_SECONDS=300
# Fold today's stops/runs into daily aggregates every N seconds.
ROLLUP_INTERVAL_SECONDS=600
# Refresh national counters / infomobility ticker every N seconds.
STATS_INTERVAL_SECONDS=300
TICKER_INTERVAL_SECONDS=900
# Live window: a run is refreshed while orario_partenza - PRE minutes <= now
# <= orario_arrivo + delay + GRACE minutes. Finished/cancelled runs are never
# refetched. No night slowdown: the 40s cadence runs 24/7.
PRE_DEPARTURE_MINUTES=30
POST_ARRIVAL_GRACE_MINUTES=5
# Max concurrent ViaggiaTreno requests (25 for the 260-station sweep)
WORKERS=25
# Only poll stations flagged is_major (see migrations/004_majors.sql + 009_rfi_topup.sql).
# Set to false for a full sweep of every seeded station.
MAJORS_ONLY=true
