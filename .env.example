# Shared by apps/web (SolidStart) and services/poller (Go).
# Copy to .env and fill in. Per-package .env files also work:
# apps/web/.env and services/poller/.env override / supplement this one.
# Lookup order for the web app: apps/web/.env, then repo-root .env,
# then launcher CWD. The poller reads services/poller/.env, then repo-root .env.

# Required by both
DATABASE_URL=postgresql://user:password@localhost:5432/train_monitor_v2

# Poller only
ACTIVE_INTERVAL_SECONDS=40
DISCOVERY_INTERVAL_SECONDS=300
ROLLUP_INTERVAL_SECONDS=600
STATS_INTERVAL_SECONDS=300
TICKER_INTERVAL_SECONDS=900
PRE_DEPARTURE_MINUTES=30
POST_ARRIVAL_GRACE_MINUTES=5
WORKERS=25
MAJORS_ONLY=true
